# --- Backend ---
# Dev default is SQLite (no setup needed). For production, point this at Postgres:
# DATABASE_URL=postgresql+asyncpg://ctf:ctf@db:5432/ctfcopilot
DATABASE_URL=sqlite+aiosqlite:///./data/ctfcopilot.db

# Per-upload size cap, in bytes. Admin-configurable.
MAX_UPLOAD_BYTES=26214400

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Model providers (not yet wired into the MVP solving loop -- classification
# and all specialist agents are deterministic code today. Reserved for a future
# reasoning step, e.g. novel-cipher identification or OCR routing.) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
